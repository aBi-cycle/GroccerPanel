<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0"
            prefWidth="950.0"
            styleClass="app-root"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="grocerPanel.Controller.editOrderController">

   <top>
      <VBox spacing="5.0"
            styleClass="page-header">

         <Label text="Edit Order"
                styleClass="page-title"/>

         <Label text="Update order details, manage selected products, or execute the order."
                styleClass="page-subtitle"/>

      </VBox>
   </top>

   <center>
      <HBox spacing="20.0">

         <padding>
            <Insets top="24.0"
                    right="24.0"
                    bottom="20.0"
                    left="24.0"/>
         </padding>

         <VBox spacing="14.0"
               prefWidth="380.0"
               styleClass="card">

            <Label text="Order Information"
                   styleClass="section-title"/>

            <VBox spacing="6.0">
               <Label text="Order ID"
                      styleClass="field-label"/>

               <TextField fx:id="IDfield"
                          promptText="Order ID"
                          prefHeight="40.0"/>
            </VBox>

            <VBox spacing="6.0">
               <Label text="Order Date"
                      styleClass="field-label"/>

               <TextField fx:id="DateField"
                          promptText="YYYY-MM-DD"
                          prefHeight="40.0"/>
            </VBox>

            <VBox spacing="6.0">
               <Label text="Customer Name"
                      styleClass="field-label"/>

               <TextField fx:id="CustomerField"
                          promptText="Customer name"
                          prefHeight="40.0"/>
            </VBox>

            <VBox spacing="6.0">
               <Label text="Order Total"
                      styleClass="field-label"/>

               <TextField fx:id="AmountField"
                          promptText="0.00"
                          prefHeight="40.0"/>
            </VBox>

            <VBox spacing="6.0">
               <Label text="Status"
                      styleClass="field-label"/>

               <TextField fx:id="StatusField"
                          promptText="Order status"
                          prefHeight="40.0"/>
            </VBox>

         </VBox>

         <VBox spacing="14.0"
               HBox.hgrow="ALWAYS"
               styleClass="card">

            <Label text="Order Items"
                   styleClass="section-title"/>

            <Label text="Select products and update quantities for this order."
                   styleClass="helper-text"/>

            <ListView fx:id="itemListView"
                      VBox.vgrow="ALWAYS"/>

         </VBox>

      </HBox>
   </center>

   <bottom>
      <HBox spacing="12.0"
            alignment="CENTER_LEFT"
            styleClass="page-footer">

         <Button fx:id="CancelButton"
                 text="Cancel"
                 prefWidth="110.0"
                 styleClass="button-ghost"
                 onAction="#onCancel"/>

         <Button fx:id="DeleteButton"
                 text="Delete Order"
                 prefWidth="130.0"
                 styleClass="button-danger"
                 onAction="#onDelete"/>

         <VBox HBox.hgrow="ALWAYS"/>

         <Button fx:id="ExecuteButton"
                 text="Execute Order"
                 prefWidth="140.0"
                 styleClass="button-gold"
                 onAction="#onExecute"/>

         <Button fx:id="SaveButton"
                 text="Save Changes"
                 prefWidth="140.0"
                 styleClass="button-primary"
                 onAction="#onSave"/>

      </HBox>
   </bottom>

</BorderPane>