<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="900.0"
            styleClass="app-root"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="grocerPanel.Controller.addInvController">

   <top>
      <VBox spacing="5.0"
            styleClass="page-header">

         <Label text="Add Product"
                styleClass="page-title"/>

         <Label text="Add a new item to the store's inventory."
                styleClass="page-subtitle"/>

      </VBox>
   </top>

   <center>
      <HBox spacing="20.0">

         <padding>
            <Insets top="24.0"
                    right="24.0"
                    bottom="20.0"
                    left="24.0"/>
         </padding>

         <VBox spacing="14.0"
               prefWidth="360.0"
               styleClass="card">

            <Label text="Product Information"
                   styleClass="section-title"/>

            <VBox spacing="6.0">
               <Label text="Product ID"
                      styleClass="field-label"/>

               <TextField fx:id="IDfield"
                          promptText="Enter product ID"
                          prefHeight="40.0"/>
            </VBox>

            <VBox spacing="6.0">
               <Label text="Product Name"
                      styleClass="field-label"/>

               <TextField fx:id="NameField"
                          promptText="Enter product name"
                          prefHeight="40.0"/>
            </VBox>

            <VBox spacing="6.0">
               <Label text="Price"
                      styleClass="field-label"/>

               <TextField fx:id="PriceField"
                          promptText="Enter price"
                          prefHeight="40.0"/>
            </VBox>

            <VBox spacing="6.0">
               <Label text="Quantity"
                      styleClass="field-label"/>

               <TextField fx:id="QuantityField"
                          promptText="Enter available quantity"
                          prefHeight="40.0"/>
            </VBox>

         </VBox>

         <VBox spacing="14.0"
               HBox.hgrow="ALWAYS"
               styleClass="card">

            <Label text="Product Details"
                   styleClass="section-title"/>

            <ImageView fx:id="PictureView"
                       fitHeight="210.0"
                       fitWidth="300.0"
                       preserveRatio="true"
                       smooth="true">

               <image>
                  <Image url="@images/defaultImage.jpg"/>
               </image>

            </ImageView>

            <Label text="Description"
                   styleClass="field-label"/>

            <TextArea fx:id="DescriptionArea"
                      promptText="Describe the product..."
                      wrapText="true"
                      prefHeight="180.0"
                      VBox.vgrow="ALWAYS"/>

         </VBox>

      </HBox>
   </center>

   <bottom>
      <HBox spacing="12.0"
            alignment="CENTER_RIGHT"
            styleClass="page-footer">

         <Button fx:id="CancelButton"
                 text="Cancel"
                 prefWidth="120.0"
                 styleClass="button-ghost"
                 onAction="#onCancel"/>

         <Button fx:id="addButton"
                 text="Add Product"
                 prefWidth="150.0"
                 styleClass="button-primary"
                 onAction="#onAdd"/>

      </HBox>
   </bottom>

</BorderPane>
