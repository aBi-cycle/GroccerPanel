<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="18.0"
      prefHeight="480.0"
      prefWidth="720.0"
      styleClass="app-root"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="grocerPanel.Controller.welcomeController">

    <padding>
        <Insets top="50.0"
                right="50.0"
                bottom="50.0"
                left="50.0"/>
    </padding>

    <Label fx:id="welcomeText"
           text="GrocerPanel"
           styleClass="page-title"/>

    <Label text="Internal Grocery Store Portal"
           styleClass="section-title"/>

    <Label text="Manage inventory, products, orders, discounts, and store users."
           styleClass="page-subtitle"
           wrapText="true"
           maxWidth="430.0"/>

    <VBox alignment="CENTER"
          spacing="12.0"
          styleClass="card"
          maxWidth="460.0">

        <Label text="Welcome to GrocerPanel"
               styleClass="section-title"/>

        <Label text="Sign in to access your store management tools."
               styleClass="page-subtitle"
               wrapText="true"/>

        <Button text="Login"
                prefWidth="190.0"
                prefHeight="44.0"
                styleClass="button-primary"
                onAction="#onLogin"/>

    </VBox>

</VBox>