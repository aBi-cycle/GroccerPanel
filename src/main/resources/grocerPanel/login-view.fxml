<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="18.0"
      prefHeight="500.0"
      prefWidth="720.0"
      styleClass="app-root"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="grocerPanel.Controller.loginController">

   <padding>
      <Insets top="50.0" right="50.0" bottom="50.0" left="50.0"/>
   </padding>

   <Label text="GrocerPanel"
          styleClass="page-title"/>

   <Label text="Employee Login"
          styleClass="section-title"/>

   <VBox spacing="14.0"
         maxWidth="380.0"
         styleClass="card">

      <Label text="Username"
             styleClass="field-label"/>

      <TextField fx:id="unameTbox"
                 promptText="Enter your username"
                 prefHeight="40.0"/>

      <Label text="Password"
             styleClass="field-label"/>

      <PasswordField fx:id="pwdTbox"
                     promptText="Enter your password"
                     prefHeight="40.0"/>

      <Label text="Use your GrocerPanel employee account to continue."
             styleClass="helper-text"
             wrapText="true"/>

      <VBox spacing="10.0"
            alignment="CENTER">

         <Button fx:id="GoButton"
                 text="Login"
                 prefWidth="220.0"
                 prefHeight="42.0"
                 defaultButton="true"
                 styleClass="button-primary"
                 onAction="#onGo"/>

         <Button fx:id="CancelButton"
                 text="Back"
                 prefWidth="220.0"
                 prefHeight="40.0"
                 styleClass="button-ghost"
                 onAction="#onCancel"/>

      </VBox>

   </VBox>

</VBox>