<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="grocerPanel.Controller.ManagerController">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
    </padding>

    <Label text="Manager Page - Users"/>
    <TableView fx:id="userTable" prefHeight="200.0">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0"/>
            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="180.0"/>
            <TableColumn fx:id="roleColumn" text="Role" prefWidth="120.0"/>
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <TextField fx:id="usernameField" promptText="Username"/>
        <TextField fx:id="passwordField" promptText="Password"/>
        <ChoiceBox fx:id="roleBox"/>
    </HBox>

    <HBox spacing="10.0">
        <Button text="Add" onAction="#onAddUser"/>
        <Button text="Update" onAction="#onUpdateUser"/>
        <Button text="Delete" onAction="#onDeleteUser"/>
        <Button text="Cancel" onAction="#onCancel"/>
    </HBox>
</VBox>
