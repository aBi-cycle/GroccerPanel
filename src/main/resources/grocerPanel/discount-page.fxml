<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="grocerPanel.Controller.discountController">
    <children>
        <VBox prefHeight="500.0" prefWidth="700.0">
            <children>
                <HBox alignment="CENTER" prefHeight="40.0" prefWidth="700.0">
                    <children>
                        <Text text="GrocerPanel - Discounts"/>
                    </children>
                </HBox>
                <TableView fx:id="discountTable" prefHeight="250.0" prefWidth="700.0">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="70" text="ID"/>
                        <TableColumn fx:id="codeColumn" prefWidth="120" text="Code"/>
                        <TableColumn fx:id="typeColumn" prefWidth="100" text="Type"/>
                        <TableColumn fx:id="valueColumn" prefWidth="100" text="Value"/>
                        <TableColumn fx:id="activeColumn" prefWidth="100" text="Active"/>
                        <TableColumn fx:id="expirationColumn" prefWidth="150" text="Expiration"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="700.0">
                    <children>
                        <TextField fx:id="codeField" promptText="Code"/>
                        <ChoiceBox fx:id="typeBox"/>
                        <TextField fx:id="valueField" promptText="Value"/>
                        <TextField fx:id="expirationField" promptText="YYYY-MM-DD"/>
                    </children>
                </HBox>

                <HBox alignment="CENTER" prefHeight="60.0" prefWidth="700.0">
                    <children>
                        <Button fx:id="addButton" text="Add" onAction="#onAdd"/>
                        <Button fx:id="updateButton" text="Update" onAction="#onUpdate"/>
                        <Button fx:id="deleteButton" text="Delete" onAction="#onDelete"/>
                        <Button fx:id="closeButton" text="Close" onAction="#onClose"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>