<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="900.0"
            styleClass="app-root"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="grocerPanel.Controller.discountController">

    <top>
        <VBox spacing="5.0"
              styleClass="page-header">

            <Label text="Discount Manager"
                   styleClass="page-title"/>

            <Label text="Create and manage promotional discount codes used by store products."
                   styleClass="page-subtitle"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets top="20.0"
                        right="24.0"
                        bottom="20.0"
                        left="24.0"/>
            </padding>

            <TableView fx:id="discountTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="codeColumn"
                                 text="Code"
                                 prefWidth="220.0"/>

                    <TableColumn fx:id="typeColumn"
                                 text="Type"
                                 prefWidth="180.0"/>

                    <TableColumn fx:id="valueColumn"
                                 text="Value"
                                 prefWidth="160.0"/>

                    <TableColumn fx:id="expirationColumn"
                                 text="Expiration Date"
                                 prefWidth="220.0"/>

                </columns>

            </TableView>

            <VBox spacing="12.0"
                  styleClass="card">

                <Label text="Discount Details"
                       styleClass="section-title"/>

                <HBox spacing="12.0">

                    <VBox spacing="6.0"
                          HBox.hgrow="ALWAYS">

                        <Label text="Discount Code"
                               styleClass="field-label"/>

                        <TextField fx:id="codeField"
                                   promptText="Example: SAVE10"
                                   prefHeight="40.0"/>

                    </VBox>

                    <VBox spacing="6.0"
                          prefWidth="160.0">

                        <Label text="Type"
                               styleClass="field-label"/>

                        <ChoiceBox fx:id="typeBox"
                                   prefHeight="40.0"
                                   maxWidth="Infinity"/>

                    </VBox>

                    <VBox spacing="6.0"
                          prefWidth="140.0">

                        <Label text="Value"
                               styleClass="field-label"/>

                        <TextField fx:id="valueField"
                                   promptText="10"
                                   prefHeight="40.0"/>

                    </VBox>

                    <VBox spacing="6.0"
                          prefWidth="190.0">

                        <Label text="Expiration"
                               styleClass="field-label"/>

                        <TextField fx:id="expirationField"
                                   promptText="YYYY-MM-DD"
                                   prefHeight="40.0"/>

                    </VBox>

                </HBox>

            </VBox>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="10.0"
              alignment="CENTER_RIGHT"
              styleClass="page-footer">

            <Button text="Add Discount"
                    prefWidth="135.0"
                    styleClass="button-primary"
                    onAction="#onAdd"/>

            <Button text="Update Discount"
                    prefWidth="145.0"
                    styleClass="button-secondary"
                    onAction="#onUpdate"/>

            <Button text="Delete Discount"
                    prefWidth="145.0"
                    styleClass="button-danger"
                    onAction="#onDelete"/>

            <Button text="Close"
                    prefWidth="100.0"
                    styleClass="button-ghost"
                    onAction="#onClose"/>

        </HBox>
    </bottom>

</BorderPane>