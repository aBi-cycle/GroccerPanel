<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0"
            prefWidth="950.0"
            styleClass="app-root"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="grocerPanel.Controller.editInvController">

   <top>
      <VBox spacing="5.0"
            styleClass="page-header">

         <Label text="Edit Product"
                styleClass="page-title"/>

         <Label text="Update product details, pricing, inventory, or discounts."
                styleClass="page-subtitle"/>

      </VBox>
   </top>

   <center>
      <HBox spacing="20.0">

         <padding>
            <Insets top="24.0"
                    right="24.0"
                    bottom="20.0"
                    left="24.0"/>
         </padding>

         <VBox spacing="14.0"
               prefWidth="380.0"
               styleClass="card">

            <Label text="Product Information"
                   styleClass="section-title"/>

            <VBox spacing="6.0">
               <Label text="Product ID"
                      styleClass="field-label"/>

               <TextField fx:id="IDfield"
                          promptText="Product ID"
                          prefHeight="40.0"/>
            </VBox>

            <VBox spacing="6.0">
               <Label text="Product Name"
                      styleClass="field-label"/>

               <TextField fx:id="NameField"
                          promptText="Product name"
                          prefHeight="40.0"/>
            </VBox>

            <VBox spacing="6.0">
               <Label text="Price"
                      styleClass="field-label"/>

               <TextField fx:id="PriceField"
                          promptText="Price"
                          prefHeight="40.0"/>
            </VBox>

            <VBox spacing="6.0">
               <Label text="Quantity"
                      styleClass="field-label"/>

               <TextField fx:id="QuantityField"
                          promptText="Quantity"
                          prefHeight="40.0"/>
            </VBox>

            <VBox spacing="6.0">
               <Label text="Discount Code"
                      styleClass="field-label"/>

               <ComboBox fx:id="discountBox"
                         promptText="Select a discount"
                         prefHeight="40.0"
                         maxWidth="Infinity"/>
            </VBox>

         </VBox>

         <VBox spacing="14.0"
               HBox.hgrow="ALWAYS"
               styleClass="card">

            <Label text="Product Details"
                   styleClass="section-title"/>

            <ImageView fx:id="PictureView"
                       fitHeight="210.0"
                       fitWidth="300.0"
                       preserveRatio="true"
                       smooth="true">

               <image>
                  <Image url="@images/defaultImage.jpg"/>
               </image>

            </ImageView>

            <Label text="Description"
                   styleClass="field-label"/>

            <TextArea fx:id="DescriptionArea"
                      promptText="Product description..."
                      wrapText="true"
                      prefHeight="180.0"
                      VBox.vgrow="ALWAYS"/>

         </VBox>

      </HBox>
   </center>

   <bottom>
      <HBox spacing="12.0"
            alignment="CENTER_LEFT"
            styleClass="page-footer">

         <Button fx:id="CancelButton"
                 text="Cancel"
                 prefWidth="120.0"
                 styleClass="button-ghost"
                 onAction="#onCancel"/>

         <Button fx:id="DeleteButton"
                 text="Delete Product"
                 prefWidth="145.0"
                 styleClass="button-danger"
                 onAction="#onDelete"/>

         <VBox HBox.hgrow="ALWAYS"/>

         <Button fx:id="SaveButton"
                 text="Save Changes"
                 prefWidth="150.0"
                 styleClass="button-primary"
                 onAction="#onSave"/>

      </HBox>
   </bottom>

</BorderPane>