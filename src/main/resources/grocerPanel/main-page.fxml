<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Box?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="grocerPanel.Controller.mainController">
   <children>
      <VBox prefHeight="400.0" prefWidth="600.0">
         <children>
            <HBox alignment="CENTER" prefHeight="38.0" prefWidth="600.0">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="GrocerPanel - Inventory" />
               </children>
            </HBox>
            <TableView fx:id="productTable" prefHeight="357.0" prefWidth="600.0">
               <columns>
                  <TableColumn fx:id="idColumn" prefWidth="50" text="ID" />
                  <TableColumn fx:id="nameColumn" prefWidth="150" text="Name" />
                  <TableColumn fx:id="descriptionColumn" prefWidth="150" text="Description" />
                  <TableColumn fx:id="priceColumn" prefWidth="80" text="Price" />
                  <TableColumn fx:id="quantityColumn" prefWidth="80" text="Quantity" />
               </columns>
            </TableView>
            <HBox alignment="CENTER" prefHeight="39.0" prefWidth="600.0">
               <children>
                  <Button fx:id="AddButton" mnemonicParsing="false" onAction="#onAdd" text="Add" />
                  <Button fx:id="EditButton" mnemonicParsing="false" onAction="#onEdit" text="Edit" />
                  <Button fx:id="ordersButton" mnemonicParsing="false" onAction="#onOrder" text="Order" />
                  <Box depth="10.0" height="10.0" opacity="0.0" width="10.0" />
                  <TextField fx:id="searchBox"/>
                  <Button fx:id= "searchButton" mnemonicParsing="false" text="Search" onAction="#onSearch" />
                  <Button fx:id="managerButton" mnemonicParsing="false" text="Manager/Settings" onAction="#onSettings" />
                  <Box depth="10.0" height="10.0" opacity="0.0" width="10.0" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
